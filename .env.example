# Local development defaults for `go run .`.
#
# Production uses the rootless Quadlet in deploy/quadlet and persists SQLite
# under %h/.local/share/phantom. These values are intentionally development-only.
XUI_DEBUG=true
XUI_DB_FOLDER=x-ui
XUI_LOG_FOLDER=x-ui/log
XUI_BIN_FOLDER=x-ui
XUI_INIT_WEB_BASE_PATH=/

# Optional runtime tuning.
#XUI_PORT=2053
#XUI_LOG_LEVEL=info
#XUI_SKIP_HSTS=false
#XUI_GOGC=75
#XUI_MEMORY_RELEASE_INTERVAL=10
#XUI_MEMORY_LIMIT=
#GOMEMLIMIT=
#XUI_PPROF=false

# Optional local Xray tunnel health monitor.
#XUI_TUNNEL_HEALTH_MONITOR=false
#XUI_TUNNEL_HEALTH_PROXY=
#XUI_TUNNEL_HEALTH_URL=https://www.cloudflare.com/cdn-cgi/trace
#XUI_TUNNEL_HEALTH_INTERVAL=30s
#XUI_TUNNEL_HEALTH_TIMEOUT=10s
#XUI_TUNNEL_HEALTH_FAILURES=3
#XUI_TUNNEL_HEALTH_COOLDOWN=5m

#XUI_DB_MAX_OPEN_CONNS=
#XUI_DB_MAX_IDLE_CONNS=
